    "convex": "^1.36.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0"
  },
