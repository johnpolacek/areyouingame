# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=dev-or-prod-deploy-key
AREYOUIN_BACKEND_SECRET=generate-a-long-random-shared-secret

# OpenAI
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_NARRATIVE_MODEL=gpt-5.4
OPENAI_CLASSIFIER_MODEL=gpt-5.4-mini

# Local persona playtests only. Leave unset/0 outside local automated smoke runs.
AREYOUIN_PLAYTEST_AUTH=0

# AWS S3 artifact storage
S3_ARTIFACT_BUCKET=areyouin-artifacts-dev
S3_ARTIFACT_REGION=us-east-1
S3_ARTIFACT_ACCESS_KEY_ID=
S3_ARTIFACT_SECRET_ACCESS_KEY=
# Optional. Character uploads fall back to the artifact bucket settings when omitted.
S3_CHARACTER_IMAGES_BUCKET=
S3_CHARACTER_IMAGES_REGION=
S3_CHARACTER_IMAGES_ACCESS_KEY_ID=
S3_CHARACTER_IMAGES_SECRET_ACCESS_KEY=
